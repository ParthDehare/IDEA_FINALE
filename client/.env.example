# VaultMind Client Environment Template (.env.example)
# Copy this file to .env and fill in your public Supabase configuration before starting Vite.
# NEVER commit keys with service-role permissions to the frontend environment.

VITE_SUPABASE_URL=https://YOUR_SUPABASE_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLIC_ANON_KEY_HERE
