# VaultMind Server Environment Template (.env.example)
# Copy this file to .env and fill in your secure credentials before starting the backend server.
# NEVER commit your actual .env file to version control.

# ── AI Models Configuration ──
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ── System Configuration ──
VAULTMIND_ENV=development
MODEL_PATH=./models/
KAFKA_BROKER=localhost:9092
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

# ── Security & Blockchain Ledger (Agent 7) ──
# 64-character hex string (32-byte AES/SHA key)
ENCRYPTION_KEY=YOUR_64_CHAR_HEX_ENCRYPTION_KEY_HERE

# ── Dynamic Fraud Thresholds (INR) ──
CLERK_LIMIT=5000000
MANAGER_LIMIT=50000000
ADMIN_LIMIT=500000000
IT_ADMIN_LIMIT=0

# ── Database Connections ──
SUPABASE_URL=https://YOUR_SUPABASE_ID.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT Authentication ──
# Use a strong random secret: `openssl rand -hex 32`
JWT_SECRET=YOUR_SECURE_RANDOM_JWT_SECRET_HERE
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=14400

# ── Notification Credentials (Notifier.py) ──
AUDITOR_EMAIL=auditor@yourdomain.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@yourdomain.com
SMTP_PASSWORD=YOUR_SMTP_APP_PASSWORD_HERE

# ── SMS Alerts (Twilio) ──
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID_HERE
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN_HERE
TWILIO_FROM_NUMBER=YOUR_TWILIO_PHONE_NUMBER_HERE
AUDITOR_PHONE=YOUR_AUDITOR_PHONE_NUMBER_HERE
